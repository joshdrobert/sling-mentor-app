<%= form_with(model: @user, url: @user.new_record? ? user_index_path : user_path(@user), local: true) do |form| %>
  <% if @user.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg mb-6">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-medium text-gray-900">Basic Information</h2>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= form.text_field :first_name, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>

        <div class="sm:col-span-3">
          <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= form.text_field :last_name, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>

        <div class="sm:col-span-3">
          <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= form.email_field :email, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>

        <div class="sm:col-span-3">
          <%= form.label :phone_number, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= form.telephone_field :phone_number, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>

        <div class="sm:col-span-3">
          <%= form.label :role, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= form.select :role, 
                  options_for_select([['Student', 'student'], ['Mentor', 'mentor']], @user.role),
                  { include_blank: 'Select a role' },
                  { class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
                    id: "role-select" } %>
          </div>
        </div>

        <div class="sm:col-span-3">
          <div class="flex h-full items-end">
            <div class="flex items-center h-5 mt-6">
              <%= form.check_box :isAdmin, class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
              <div class="ml-3 text-sm">
                <%= form.label :isAdmin, "Admin Privileges", class: "font-medium text-gray-700" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Student Fields (Initially hidden if user is a mentor) -->
  <div id="student-fields" class="bg-white shadow rounded-lg mb-6" style="<%= 'display: none;' if @user.role != 'student' %>">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-medium text-gray-900">Student Information</h2>
    </div>
    <div class="p-6">
      <%= fields_for :student do |student_form| %>
        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
          <div class="sm:col-span-3">
            <%= student_form.label :major, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= student_form.text_field :major, value: @student&.major, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
            </div>
          </div>

          <div class="sm:col-span-3">
            <%= student_form.label :classification, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= student_form.select :classification,
                    options_for_select(['Freshman', 'Sophomore', 'Junior', 'Senior', 'Graduate'], @student&.classification),
                    { include_blank: 'Select a classification' },
                    { class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" } %>
            </div>
          </div>

          <div class="sm:col-span-6">
            <%= student_form.label :specialty_id, "Specialty", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= student_form.collection_select :specialty_id,
                    Specialty.all,
                    :id,
                    :name,
                    { include_blank: 'Select a specialty', selected: @student&.specialty_id },
                    { class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Mentor Fields (Initially hidden if user is a student) -->
  <div id="mentor-fields" class="bg-white shadow rounded-lg mb-6" style="<%= 'display: none;' if @user.role != 'mentor' %>">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-medium text-gray-900">Mentor Information</h2>
    </div>
    <div class="p-6">
      <%= fields_for :mentor do |mentor_form| %>
        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
          <div class="sm:col-span-6">
            <%= mentor_form.label :profession, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= mentor_form.text_field :profession, value: @mentor&.profession, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
            </div>
          </div>

          <div class="sm:col-span-3">
            <%= mentor_form.label :specialty_id, "Specialty", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= mentor_form.collection_select :specialty_id,
                    Specialty.all,
                    :id,
                    :name,
                    { include_blank: 'Select a specialty', selected: @mentor&.specialty_id },
                    { class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" } %>
            </div>
          </div>

          <div class="sm:col-span-3">
            <%= mentor_form.label :mentor_type_id, "Mentor Type", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= mentor_form.collection_select :mentor_type_id,
                    MentorType.all,
                    :id,
                    :name,
                    { include_blank: 'Select a mentor type', selected: @mentor&.mentor_type_id },
                    { class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex justify-between">
    <%= link_to 'Cancel', @user.new_record? ? admin_index_path : admin_path(@user), class: 'px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
    <%= form.submit @user.new_record? ? 'Create User' : 'Update User', class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('role-select');
    const studentFields = document.getElementById('student-fields');
    const mentorFields = document.getElementById('mentor-fields');

    roleSelect.addEventListener('change', function() {
      if (this.value === 'student') {
        studentFields.style.display = 'block';
        mentorFields.style.display = 'none';
      } else if (this.value === 'mentor') {
        studentFields.style.display = 'none';
        mentorFields.style.display = 'block';
      } else {
        studentFields.style.display = 'none';
        mentorFields.style.display = 'none';
      }
    });
  });
</script>