<div id="<%= dom_id student %>">

  <p>
    <strong>First name:</strong>
    <%= student.user.first_name %>
  </p>

  <p>
    <strong>Last name:</strong>
    <%= student.user.last_name %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= student.user.email %>
  </p>

  <p>
    <strong>major:</strong>
    <%= student.major %>
  </p>

  <p>
    <strong>classification:</strong>
    <%= student.classification %>
  </p>

  <p>
    <strong>specialty:</strong>
    <%= student.specialty %>
  </p>

</div>
