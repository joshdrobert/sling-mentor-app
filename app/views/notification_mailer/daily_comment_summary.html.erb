<p>Hello <%= @question.user.first_name %>,</p>

<p>
  Here's a quick summary of the latest comments on your question:
  <strong>"<%= @question.question %>"</strong>
</p>

<hr>

<% @comments.each do |comment| %>
  <div style="margin-bottom: 20px;">
    <p style="margin: 0;">
      <strong><%= comment.user.first_name %> <%= comment.user.last_name %></strong> said:
    </p>
    <blockquote style="margin: 8px 0; padding-left: 10px; border-left: 3px solid #ccc;">
      <%= comment.content %>
    </blockquote>
    <p style="font-size: 12px; color: #888; margin-top: 0;">
      Posted <%= time_ago_in_words(comment.created_at) %> ago
    </p>
  </div>
<% end %>

<hr>

<p>
  To view the full discussion or reply to comments, click below:
</p>

<p>
  <a href="<%= question_url(@question) %>" style="background: #4CAF50; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
    View Full Discussion
  </a>
</p>
<br>
<p>Thanks,<br>The Slinghealth Team</p>
