<div class="flex justify-center p-4">
  <div class="bg-white shadow rounded-lg w-full">
    <div class="border-b border-gray-200 px-6 py-4 text-center">
      <h2 class="text-lg font-medium">Mentor Information</h2>
    </div>
    <div class="p-6">
      <div class="text-center mb-6">
        <% if mentor.user.image.present? %>
          <%= image_tag mentor.user.image, class: 'rounded-full mx-auto', width: 120, height: 120, style: 'object-fit: cover;' %>
        <% else %>
          <div class="flex justify-center items-center w-24 h-24 rounded-full bg-gray-100 mx-auto text-3xl font-medium text-gray-600">
            <%= mentor.user.first_name[0].upcase %><%= mentor.user.last_name[0].upcase %>
          </div>
        <% end %>
        <h3 class="mt-4 text-lg font-medium text-gray-900"><%= "#{mentor.user.first_name} #{mentor.user.last_name}" %></h3>
      </div>

      <div class="border-t border-gray-200 -mx-6">
        <dl>
          <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium text-gray-500">Email</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 text-right"><%= mentor.user.email %></dd>
          </div>

          <% if mentor.user.phone_number.present? %>
            <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4 bg-gray-50">
              <dt class="text-sm font-medium text-gray-500">Phone</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 text-right">
                <%= "(#{mentor.user.phone_number[0..2]}) #{mentor.user.phone_number[3..5]}-#{mentor.user.phone_number[6..9]}" %>
              </dd>
            </div>
          <% else %>
            <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4 bg-gray-50">
              <dt class="text-sm font-medium text-gray-500">Phone</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 text-right">Not Provided</dd>
            </div>
          <% end %>

          <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium text-gray-500">Mentor Type</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 text-right"><%= mentor.mentor_type&.name || "Not Specified" %></dd>
          </div>

          <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4 bg-gray-50">
            <dt class="text-sm font-medium text-gray-500">Specialty</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 text-right"><%= mentor.specialties.any? ? mentor.specialties.map(&:name).join(', ') : "Not Specified" %></dd>
          </div>

          <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium text-gray-500">Profession</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 text-right"><%= mentor.profession %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>

<% if current_user && current_user.mentor && mentor.id == current_user.mentor.id %>
  <div class="text-center">
    <%= link_to 'Edit Your Info', edit_mentor_path(mentor), class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>
<% end %>
