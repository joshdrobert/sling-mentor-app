<div class="container mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-6">User Administration</h1>


  <div class="bg-white rounded-lg shadow mb-6">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-medium">Specialties</h2>
    </div>
    <div class="p-6">
      <%= link_to new_specialty_path, class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' do %>
      New Specialty
      <% end %>
      <%= link_to specialties_path, class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' do %>
        Show Specialties
      <% end %>
    </div>
  </div> 
  
  
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-medium">Search Users</h2>
    </div>
    <div class="p-6">
      <%= form_with url: admin_index_path, method: :get, class: 'mb-0' do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
          <div class="md:col-span-4">
            <div class="flex">
              <%= f.text_field :search, value: params[:search], class: 'w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50', placeholder: 'Search by name or email' %>
            </div>
          </div>
          
          <div class="md:col-span-3">
            <%= f.select :role, [['All Roles', ''], ['Mentors', 'mentor'], ['Students', 'student']], 
                        { selected: params[:role] }, 
                        { class: 'w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50' } %>
          </div>
          
          <div class="md:col-span-2">
            <%= f.submit 'Search', class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
            <%= link_to 'Reset', admin_index_path, class: 'ml-2 inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
          </div>
          
          <div class="md:col-span-3 text-right">

            <%= link_to new_admin_path, class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500' do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
              New User
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="flex justify-between items-center border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-medium">Users</h2>
      <div class="flex items-center">
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-indigo-100 text-indigo-800"><%= @users.count %> results</span>
      </div>
    </div>
    <div class="w-full">
      <table class="w-full divide-y divide-gray-200 table-fixed">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/6">Name</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/6">Email</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/6">Role</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-2/6">Details</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-1/6">Actions</th>
            </tr>
          </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @users.each do |user| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-4">
                <div class="text-sm font-medium text-gray-900 truncate"><%= "#{user.first_name} #{user.last_name}" %></div>
              </td>
              <td class="px-4 py-4">
                <div class="text-sm text-gray-500 truncate"><%= user.email %></div>
              </td>
              <td class="px-4 py-4">
                <div class="flex flex-wrap gap-1">
                  <% if user.role == "mentor" %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Mentor</span>
                  <% elsif user.role == "student" %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Student</span>
                  <% else %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Other</span>
                  <% end %>
                  <% if user.isAdmin %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Admin</span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if user.role == "mentor" %>
                  <% if user.mentor.present? %>
                    <div class="text-sm text-gray-500">
                      <!-- Display mentor type (profession) on top -->
                      <div class="font-medium text-gray-900"><%= user.mentor.profession %></div>
                      
                      <!-- Display specialties below the mentor type -->
                      <% if user.mentor.specialties.any? %>
                        <div class="mt-2 text-gray-500">
                          <%= user.mentor.specialties.map(&:name).join(', ') %> <!-- Join all specialty names with a comma and space -->
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                <% elsif user.role == "student" %>
                  <% if user.student.present? %>
                    <div class="text-sm text-gray-500">
                      <%= user.student.major %>
                      <% if user.student.classification.present? %>
                        · <%= user.student.classification %>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex flex-col items-end justify-end">
                  <%= link_to admin_path(user), class: 'text-indigo-600 hover:text-indigo-900 mr-3', title: 'View' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                      <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                  <%= link_to edit_admin_path(user), class: 'text-indigo-600 hover:text-indigo-900 mr-3', title: 'Edit' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                  <% end %>
                  <%= button_to admin_path(user), method: :delete, 
                              class: 'text-red-600 hover:text-red-900 inline-block mt-2', 
                              form: { data: { turbo_confirm: "Are you sure you want to delete #{user.first_name} #{user.last_name}?" } },
                              title: 'Delete' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          
          <% if @users.empty? %>
            <tr>
              <td colspan="5" class="px-6 py-10 text-center">
                <p class="text-gray-500">No users found matching your search criteria.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  
  <% if @users.respond_to?(:total_pages) %>
    <div class="flex justify-center mt-6">
      <%= paginate @users, window: 2 %>
    </div>
  <% end %>
</div>