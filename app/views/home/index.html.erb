
<div class="px-4 py-12 text-center">
  <h1 class="mb-6 text-4xl font-bold text-gray-900">Welcome to SlingHealth Mentors</h1>
</div>

<!-- Call to Action Buttons -->
<div class="max-w-5xl px-4 py-6 mx-auto">
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
    <!-- See Mentors Button -->
    <button 
      class="w-full sm:w-auto flex items-center justify-center px-8 py-4 text-white transition-colors bg-sling-purple rounded-lg hover:bg-sling-purple-dark shadow-md"
      onclick="window.location.href='/mentors';"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
