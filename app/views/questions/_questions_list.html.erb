<div style="display: grid; 
grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
gap: 20px;
max-width: 1600px;
margin: 0 auto;">
<% if @questions.present? %>
  <% @questions.each do |question| %>
    <%= link_to question_path(question), class: "grid-card", style: "text-decoration: none; color: inherit;" do %>
      <div style="display: flex; align-items: end; gap: 8px; font-size: 0.9rem;">
        <img src="https://upload.wikimedia.org/wikipedia/commons/a/ac/Default_pfp.jpg" alt="Default Profile Picture" style="width: 30px; height: 30px; border-radius: 50%;">
        
        <span style="margin: 0; font-weight: 600">
          <%= question.user.email.split('@').first %> (<%= question.user.role.capitalize %>)
        </span>
        <p style="color: #8ba2ad;">•</p>
        <p style="color: #8ba2ad;"><%= time_ago_in_words(question.created_at).gsub("about ", "").gsub("less than a", "< 1") %> ago</p>
      </div>
      <div style = "display: flex; gap: 5px; margin-bottom: -12px;"> 
        <div class = "bubble"><%= question.mentor_type.short_name %></div>
        <% if question.specialty.present? %>
        <div class="bubble"><%= question.specialty.short_name %></div>
      <% end %>
      </div>
      <p class="card-text-1">
        <%= question.question %>
      </p>
      <p style="color: #8ba2ad; margin-top: auto;">
        <%= question.comment_count %> comments
      </p>
    <% end %>
  <% end %>
<% else %>
  <p>No questions available.</p>
<% end %>

</div>
