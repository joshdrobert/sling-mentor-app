<div class="modal-container">
  <% if current_user.present? %>
    <button class="fixed px-4 py-2 text-4xl font-bold text-white bg-blue-500 rounded-full shadow-lg open-modal-btn bottom-6 right-6 hover:bg-blue-700">
      +
    </button>
  <% else %>
    <button class="fixed px-4 py-2 text-4xl font-bold text-white rounded-full shadow-lg cursor-not-allowed bottom-6 right-6" style="pointer-events: none; background: lightgray;">
      +
    </button>
  <% end %>

  <div class="fixed inset-0 flex items-center justify-center hidden bg-gray-800 bg-opacity-50 modal">
    <div class="p-6 bg-white rounded-lg shadow-lg">
      <h2 class="mb-4 text-lg font-bold">New Question</h2>

      <%= form_with model: @post, local: true, html: { id: 'post-form' } do |form| %>
        <div class="mb-4">
          <%= form.label :question, class: 'block' do %>
            Title <span>*</span>
          <% end %>
          <%= form.text_field :question, class: 'w-full px-3 py-2 border border-gray-300 rounded-md', required: true, minlength: 3, maxlength: 100 %>
        </div>

        <div class="mb-4">
          <%= form.label :description, class: 'block' do %>
            Description
          <% end %>
          <%= form.text_area :description, class: 'w-full px-3 py-2 border border-gray-300 rounded-md' %>
        </div>

        <div class="flex mb-4 mentor-specialty-dropdowns">
          <div style="margin-right: 60px;">
            <%= form.label :mentor_type, class: 'block' do %>
              Mentor Type <span>*</span>
            <% end %>
            <%= form.select :mentor_type, MentorType.pluck(:name).uniq, { include_blank: 'Select Mentor Type' }, { class: 'form-control mentor-select', required: true, style: 'display: inline-block; padding: 5px;' } %>
          </div>
          <div>
            <%= form.label :specialty, class: 'block' do %>
              Specialty
            <% end %>
            <%= form.select :specialty, [], { include_blank: 'Select a specialty' }, { class: 'form-control specialty-select',  style: ' padding: 5px;' } %>
          </div>
        </div>

        <div class="flex items-center justify-center">
          <button type="button" class="px-4 py-2 text-gray-300 border border-gray-300 rounded close-modal-btn" style="margin-right: 30px;">Close</button>
          <button type="submit" class="px-4 py-2 text-white bg-blue-500 rounded">Submit</button>
        </div>
      <% end %>

    </div>
  </div>
</div>

<div style = "padding: 20px;">
  <div class="flex justify-end w-full" >
    <%= form_tag questions_path, method: :get, remote: true do%>
      <div class = "flex mentor-specialty-dropdowns" style=" margin-bottom: 20px; gap:12px;">
        <%= select_tag :mentorType,
          options_for_select([['All mentor types', '']] + MentorType.pluck(:name).uniq.map { |type| [type, type] }, params[:mentorType]),
          class: 'form-control mentor-select',
          style: "padding: 5px;"
        %>
        <%= select_tag :specialty,
              options_for_select([['All specialties', '']], params[:specialty]),
              class: 'form-control specialty-select',
              style: "padding: 5px;",
              onchange: "this.form.submit();"
              %>
        <%= select_tag :sortBy,
              options_for_select(["Newest", "Oldest", "Most comments", "Least comments"], params[:sortBy] || "Newest"),
              class: 'form-control',
              style: "padding: 5px;",
              onchange: "this.form.submit();" %>
      </div>


    <% end %>
  </div>

  <%= render 'questions_list' %>


</div>

<div class="pagination">
  <%= will_paginate @questions,
    previous_label: '‹',
    next_label: '›',
    inner_window: 2,   # Number of page links inside the main range
    outer_window: 2,   # Number of page links outside the truncation (...), keeping it more consistent
    class: 'pagination flex flex-wrap justify-center gap-1',
    page_links: true,
    link_class: 'px-3 py-1 rounded border border-gray-300 bg-gray-50 hover:bg-gray-100 text-gray-700 text-center min-w-[2.25rem]',
    active_class: 'bg-purple-600 text-white border-purple-700',
    disabled_class: 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed',
    gap_class: 'px-2' %>
</div>
