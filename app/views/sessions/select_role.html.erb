<!-- Role Selection Container -->
<div class="max-w-xl mx-auto mt-10">
  <!-- Header Section-->
  <div class="bg-sling-purple py-4">
    <h1 class="text-2xl font-bold text-white text-center">Select Your Role</h1>
  </div>
  
  <!-- Content Section -->
  <div class="px-6 py-8 bg-white">
    <p class="text-gray-700 text-center mb-8">Please select if you are a Mentor or a Student:</p>
    
    <%= form_with url: update_role_path, method: :post do %>
      <div class="flex justify-center space-x-12 mb-8">
        <!-- Student Option -->
        <div class="flex items-center">
          <%= radio_button_tag 'user[role]', 'student', false, id: 'role_student', class: 'h-5 w-5 text-purple-600' %> 
          <%= label_tag 'role_student', 'Student', class: 'ml-3 text-lg text-gray-700' %>
        </div>
        
        <!-- Mentor Option -->
        <div class="flex items-center">
          <%= radio_button_tag 'user[role]', 'mentor', false, id: 'role_mentor', class: 'h-5 w-5 text-purple-600' %> 
          <%= label_tag 'role_mentor', 'Mentor', class: 'ml-3 text-lg text-gray-700' %>
        </div>
      </div>
      
      <!-- Submit Button -->
      <div class="flex justify-center">
        <%= submit_tag "Continue", class: "px-6 py-3 bg-sling-purple text-white font-medium rounded-md hover:bg-sling-purple-dark transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
      </div>
    <% end %>
  </div>
</div>
